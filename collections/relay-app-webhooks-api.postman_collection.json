          "name": "Trigger Webhook Workflow",
          "request": {
            "name": "Trigger Webhook Workflow",
            "description": {
              "content": "Triggers a workflow run by sending an HTTP POST request to the workflow's unique webhook endpoint. The workflow is started immediately when a valid HTTP request is received. A relayDeduplicationKey can be provided to ensure each unique workflow is only triggered once per key.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webhooks",
                ":webhookId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "webhookId",
                  "description": "(Required) The unique identifier for the webhook-triggered workflow."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "A unique key to prevent duplicate workflow runs. If a run with this key has already been triggered, the new request will be deduplicated.",
